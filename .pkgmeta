package-as: XalsWarchest

# Files/folders in the repo that shouldn't end up inside the distributed addon
# zip - players don't need CI config or git's own housekeeping files.
ignore:
  - .github
  - .gitignore
  - images
  - ArtSource

# Shown on CurseForge as an optional dependency: with Shortest Path Forever
# installed, "Go to nearest vendor" draws a real walking route (WoW Forever).
optional-dependencies:
  - shortest-path-forever

# Use our hand-maintained, styled changelog as the release changelog on
# CurseForge instead of the packager's auto-generated commit list.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
